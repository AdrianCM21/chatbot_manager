APP_NAME="WhatsApp Bot"
APP_ENV=dusk.local
APP_KEY=base64:J74digYLDYb4QMQo/P+syiRIV1o12ypakRiuvfoR3+A=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chatbot_dusk
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=array

# Para los tests que sí necesitan una llamada real (ConnectionSettingsFlowTest
# prueba contra la Graph API real con un token inválido), no hace falta cargar
# credenciales reales acá. Para el resto, WhatsAppBotFlowTest usa Http::fake().
DEEPSEEK_API_KEY=dusk-fake-key
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=dusk-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dusk-verify-token
