APP_NAME="WhatsApp Bot"
APP_ENV=testing
APP_KEY=base64:J74digYLDYb4QMQo/P+syiRIV1o12ypakRiuvfoR3+A=
APP_DEBUG=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# sqlite no soporta la columna `vector` (pgvector) de products.embedding:
# la suite corre contra una base Postgres de test real, no in-memory.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chatbot_test
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=array

DEEPSEEK_API_KEY=test-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-vl
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
DEEPSEEK_EMBEDDING_DIMENSIONS=8

WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=test-phone-number-id
WHATSAPP_ACCESS_TOKEN=test-access-token
WHATSAPP_APP_SECRET=test-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=test-verify-token
